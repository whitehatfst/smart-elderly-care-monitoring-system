# 统一换行符，避免跨平台 diff 噪声
* text=auto eol=lf

*.py    text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.csv   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.hdf5  binary
*.pickle binary
*.mp4   binary
*.avi   binary
